behavior {
    theme "Kon"

    quickSelect {
        activateOnAnyCharacter false
    }
}

keyBindings {
    // Vim-style navigation
    "j" "core.move.down"
    "k" "core.move.up"
    "h" "core.go.up"
    "l" "core.open"

    // Selection with Shift
    "Shift+j" "core.select.move.down"
    "Shift+k" "core.select.move.up"

    // Fast navigation
    "g" "core.move.home"
    "Shift+g" "core.move.end"
    "Ctrl+d" "core.move.half.page.down"
    "Ctrl+u" "core.move.half.page.up"

    // Pane switching
    "Tab" "core.move.left"
    "Shift+Tab" "core.move.right"

    // Open and preview
    "o" "core.open"
    "Return" "core.open"
    "Space" "core.preview"

    // File operations
    "y" "core.copy"
    "p" "core.paste"
    "d" "core.trash"
    "Shift+d" "core.delete"
    "r" "core.rename"
    "a" "core.new.file"
    "Shift+a" "core.new.directory"

    // Search and filter
    "/" "core.finder"
    "Escape" "core.cancel"

    // Tab operations
    "t" "core.tab.new"
    "Shift+t" "core.clone"
    "x" "core.tab.close"
    "1" { id "core.tab.select" index 0 }
    "2" { id "core.tab.select" index 1 }
    "3" { id "core.tab.select" index 2 }
    "4" { id "core.tab.select" index 3 }
    "5" { id "core.tab.select" index 4 }

    // Other
    "." "core.refresh"
    "Cmd+." "core.show.hidden"
    "Shift+?" "core.actions"
}
